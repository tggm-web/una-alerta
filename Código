* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #20343a;
    background: #f2f8f8;
}

header {
    background: #0d5965;
    color: white;
    padding: 28px 16px;
    text-align: center;
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

main {
    max-width: 950px;
    margin: 24px auto;
    padding: 0 16px;
}

section {
    background: white;
    margin-bottom: 18px;
    padding: 22px;
    border-radius: 12px;
    border-left: 5px solid #168078;
}

h2 {
    color: #0d5965;
}

footer {
    background: #123f49;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 600px) {
    nav {
        flex-direction: column;
        gap: 8px;
    }

    section {
        padding: 16px;
    }
}
